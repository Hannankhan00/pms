// Prisma Schema for Pharmacy Management System (PMS)
// Phase 1: Multi-Tenant Architecture & Complete Pharmacy Operations Engine
// Database Provider: MySQL (Production Ready)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN_TO_SUPPLIER
  CUSTOMER_RETURN
  EXPIRY_DISPOSAL
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  HOLD
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  BANK_TRANSFER
  INSURANCE
  CHEQUE
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  MISC_INCOME
}

enum AccountType {
  ACCOUNTS_PAYABLE
  ACCOUNTS_RECEIVABLE
  CASH_DRAWER
  BANK
  OPERATING_EXPENSE
  REVENUE
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

enum PrescriptionStatus {
  PENDING
  VERIFIED
  DISPENSED
  REJECTED
  PARTIALLY_DISPENSED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ShiftTransactionType {
  CASH_DROP
  PAYOUT
  ADJUSTMENT
}

// ============================================================================
// GROUP 1: TENANT, IDENTITY & RBAC
// ============================================================================

/// Tenant represents an independent pharmacy organization.
/// The Central Hub will eventually own master billing and provisioning.
model Tenant {
  id            String       @id @default(uuid())
  name          String       @db.VarChar(191)
  slug          String       @unique @db.VarChar(191)
  status        TenantStatus @default(ACTIVE)
  defaultLocale String       @default("en") @db.VarChar(10)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Tenant Scoped Relations
  users             PharmacyUser[]
  roles             Role[]
  branches          Branch[]
  warehouses        Warehouse[]
  storageLocations  StorageLocation[]
  categories        Category[]
  manufacturers     Manufacturer[]
  generics          Generic[]
  brands            Brand[]
  dosageForms       DosageForm[]
  units             Unit[]
  medicines         Medicine[]
  batches           MedicineBatch[]
  inventoryLedgers  InventoryLedger[]
  suppliers         Supplier[]
  customers         Customer[]
  patients          Patient[]
  doctors           Doctor[]
   purchases            Purchase[]
   sales                Sale[]
   payments             Payment[]
   prescriptions        Prescription[]
   expenses             Expense[]
   expenseCategories    ExpenseCategory[]
   supplierPaymentLinks SupplierPaymentLink[]
   customerPaymentLinks CustomerPaymentLink[]
   accountLedgers       AccountLedger[]
   auditLogs            AuditLog[]
   shifts               Shift[]
   shiftTransactions    ShiftTransaction[]

  @@map("tenants")
}

/// Role defines authorization groupings within a tenant or as system defaults.
model Role {
  id          String   @id @default(uuid())
  tenantId    String?  @db.VarChar(191)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       PharmacyUser[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

/// Granular permission code (e.g. 'inventory.view', 'sales.create').
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  module      String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Join table between Role and Permission.
model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @db.VarChar(191)
  permissionId String   @db.VarChar(191)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// PharmacyUser maps a tenant member to a local role and their future Hub identity.
model PharmacyUser {
  id        String   @id @default(uuid())
  tenantId  String   @db.VarChar(191)
  hubUserId String   @db.VarChar(191)
  roleId    String   @db.VarChar(191)
  branchId  String?  @db.VarChar(191)
  name      String   @db.VarChar(191)
  email     String   @db.VarChar(191)
  locale    String   @default("en") @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sales                 Sale[]
  auditLogs             AuditLog[]
  shifts                Shift[]
  verifiedPrescriptions Prescription[] @relation("VerifiedPrescriptions")
  recordedExpenses      Expense[]      @relation("RecordedExpenses")
  recordedPayments      Payment[]      @relation("RecordedPayments")

  @@unique([tenantId, email])
  @@unique([tenantId, hubUserId])
  @@index([tenantId])
  @@index([hubUserId])
  @@index([roleId])
  @@index([branchId])
  @@map("pharmacy_users")
}

// ============================================================================
// GROUP 2: FACILITIES
// ============================================================================

/// Branch represents a physical retail or hospital pharmacy location.
model Branch {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(191)
  code        String    @db.VarChar(50)
  address     String?   @db.VarChar(255)
  phone       String?   @db.VarChar(50)
  contactInfo String?   @db.VarChar(255)
  isMain      Boolean   @default(false)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            PharmacyUser[]
  shifts           Shift[]
  storageLocations StorageLocation[]
  inventoryLedgers InventoryLedger[]
  purchases        Purchase[]
  sales            Sale[]
  expenses         Expense[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

/// Warehouse represents a centralized pharmaceutical distribution or storage depot.
model Warehouse {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(191)
  code        String?   @db.VarChar(50)
  address     String?   @db.VarChar(255)
  contactInfo String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storageLocations StorageLocation[]
  inventoryLedgers InventoryLedger[]
  purchases        Purchase[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("warehouses")
}

/// StorageLocation represents a granular shelf, rack, bin, or cold-chain fridge.
model StorageLocation {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(100)
  code        String?   @db.VarChar(50)
  description String?   @db.VarChar(255)
  branchId    String?   @db.VarChar(191)
  warehouseId String?   @db.VarChar(191)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryLedgers InventoryLedger[]

  @@unique([tenantId, branchId, warehouseId, name])
  @@index([tenantId])
  @@index([branchId])
  @@index([warehouseId])
  @@map("storage_locations")
}

// ============================================================================
// GROUP 3: MEDICINE MASTER (CATALOG)
// ============================================================================

/// Category organizes medicines into therapeutic or operational classifications.
model Category {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(100)
  nameAr      String?   @db.VarChar(100)
  nameFr      String?   @db.VarChar(100)
  nameIt      String?   @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

/// Manufacturer represents pharmaceutical manufacturing laboratories and companies.
model Manufacturer {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(150)
  contactInfo String?   @db.VarChar(255)
  address     String?   @db.VarChar(255)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("manufacturers")
}

/// Generic represents the active chemical entity or salt composition (e.g. Paracetamol).
model Generic {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("generics")
}

/// Brand represents commercial trade names marketed by pharmaceutical entities.
model Brand {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

/// DosageForm specifies administration method (e.g. Tablet, Syrup, Injection, Capsule).
model DosageForm {
  id          String    @id @default(uuid())
  tenantId    String    @db.VarChar(191)
  name        String    @db.VarChar(100)
  nameAr      String?   @db.VarChar(100)
  nameFr      String?   @db.VarChar(100)
  nameIt      String?   @db.VarChar(100)
  description String?   @db.VarChar(255)
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?   @db.VarChar(191)
  updatedBy   String?   @db.VarChar(191)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("dosage_forms")
}

/// Unit defines dispensing packaging (e.g. Strip, Bottle, Box, Vial).
model Unit {
  id           String    @id @default(uuid())
  tenantId     String    @db.VarChar(191)
  name         String    @db.VarChar(50)
  nameAr       String?   @db.VarChar(50)
  nameFr       String?   @db.VarChar(50)
  nameIt       String?   @db.VarChar(50)
  abbreviation String?   @db.VarChar(20)
  description  String?   @db.VarChar(255)
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?   @db.VarChar(191)
  updatedBy    String?   @db.VarChar(191)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("units")
}

/// Medicine is the master product catalog entity representing pharmaceutical SKUs.
model Medicine {
  id                     String    @id @default(uuid())
  tenantId               String    @db.VarChar(191)
  sku                    String    @db.VarChar(100)
  barcode                String?   @db.VarChar(100)
  name                   String    @db.VarChar(191)
  nameAr                 String?   @db.VarChar(191)
  nameFr                 String?   @db.VarChar(191)
  nameIt                 String?   @db.VarChar(191)
  genericId              String?   @db.VarChar(191)
  brandId                String?   @db.VarChar(191)
  manufacturerId         String?   @db.VarChar(191)
  categoryId             String?   @db.VarChar(191)
  dosageFormId           String?   @db.VarChar(191)
  unitId                 String?   @db.VarChar(191)
  strength               String?   @db.VarChar(50)
  reorderLevel           Int       @default(10)
  isPrescriptionRequired Boolean   @default(false)
  isNarcotic             Boolean   @default(false)
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?   @db.VarChar(191)
  updatedBy              String?   @db.VarChar(191)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generic           Generic?           @relation(fields: [genericId], references: [id], onDelete: SetNull)
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  manufacturer      Manufacturer?      @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dosageForm        DosageForm?        @relation(fields: [dosageFormId], references: [id], onDelete: SetNull)
  unit              Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  batches           MedicineBatch[]
  inventoryLedgers  InventoryLedger[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  prescriptionItems PrescriptionItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([genericId])
  @@index([brandId])
  @@index([manufacturerId])
  @@index([categoryId])
  @@index([dosageFormId])
  @@index([unitId])
  @@index([barcode])
  @@map("medicines")
}

// ============================================================================
// GROUP 4: INVENTORY & BATCHES
// ============================================================================

/// MedicineBatch tracks distinct pharmaceutical production lots, expiry dates, and unit pricing.
model MedicineBatch {
  id            String    @id @default(uuid())
  tenantId      String    @db.VarChar(191)
  medicineId    String    @db.VarChar(191)
  batchNumber   String    @db.VarChar(100)
  mfgDate       DateTime?
  expiryDate    DateTime
  purchasePrice Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  mrp           Decimal?  @db.Decimal(12, 2)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?   @db.VarChar(191)
  updatedBy     String?   @db.VarChar(191)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicine         Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  inventoryLedgers InventoryLedger[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]

  @@unique([tenantId, medicineId, batchNumber])
  @@index([tenantId])
  @@index([medicineId])
  @@index([expiryDate])
  @@map("medicine_batches")
}

/// InventoryLedger is an immutable double-entry style ledger tracking physical stock movement.
model InventoryLedger {
  id                String                   @id @default(uuid())
  tenantId          String                   @db.VarChar(191)
  branchId          String?                  @db.VarChar(191)
  warehouseId       String?                  @db.VarChar(191)
  storageLocationId String?                  @db.VarChar(191)
  medicineId        String                   @db.VarChar(191)
  batchId           String                   @db.VarChar(191)
  transactionType   InventoryTransactionType
  quantity          Decimal                  @db.Decimal(12, 2) // Positive for inflows, negative for outflows
  referenceId       String?                  @db.VarChar(191) // Links to Purchase, Sale, or Transfer
  referenceType     String?                  @db.VarChar(50)
  notes             String?                  @db.VarChar(255)
  createdAt         DateTime                 @default(now())
  createdBy         String?                  @db.VarChar(191)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse       Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  medicine        Medicine         @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch           MedicineBatch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([storageLocationId])
  @@index([medicineId])
  @@index([batchId])
  @@index([transactionType])
  @@index([referenceId])
  @@index([createdAt])
  @@map("inventory_ledgers")
}

// ============================================================================
// GROUP 5: ENTITIES (CRM & CLINICAL)
// ============================================================================

/// Supplier represents pharmaceutical distributors, wholesalers, and vendors.
model Supplier {
  id             String    @id @default(uuid())
  tenantId       String    @db.VarChar(191)
  name           String    @db.VarChar(191)
  contactPerson  String?   @db.VarChar(150)
  phone          String?   @db.VarChar(50)
  email          String?   @db.VarChar(191)
  address        String?   @db.VarChar(255)
  taxId          String?   @db.VarChar(100) // GST, VAT, NTN, or Tax Registration
  currentBalance Decimal   @default(0.00) @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.VarChar(191)
  updatedBy      String?   @db.VarChar(191)

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  accountLedgers AccountLedger[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

/// Customer represents retail pharmacy clients, accounts, or purchasing individuals.
model Customer {
  id             String    @id @default(uuid())
  tenantId       String    @db.VarChar(191)
  name           String    @db.VarChar(191)
  phone          String?   @db.VarChar(50)
  email          String?   @db.VarChar(191)
  address        String?   @db.VarChar(255)
  creditLimit    Decimal   @default(0.00) @db.Decimal(12, 2)
  currentBalance Decimal   @default(0.00) @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.VarChar(191)
  updatedBy      String?   @db.VarChar(191)

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patients       Patient[]
  sales          Sale[]
  accountLedgers AccountLedger[]

  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

/// Patient records clinical patient demographics, allergies, and prescription histories.
model Patient {
  id             String    @id @default(uuid())
  tenantId       String    @db.VarChar(191)
  customerId     String?   @db.VarChar(191)
  name           String    @db.VarChar(191)
  dob            DateTime?
  gender         String?   @db.VarChar(20) // MALE, FEMALE, OTHER
  bloodGroup     String?   @db.VarChar(10)
  allergies      String?   @db.Text
  medicalHistory String?   @db.Text
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.VarChar(191)
  updatedBy      String?   @db.VarChar(191)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  prescriptions Prescription[]

  @@index([tenantId])
  @@index([customerId])
  @@map("patients")
}

/// Doctor registers prescribing medical practitioners and license credentials.
model Doctor {
  id                  String    @id @default(uuid())
  tenantId            String    @db.VarChar(191)
  name                String    @db.VarChar(191)
  specialization      String?   @db.VarChar(150)
  licenseNumber       String?   @db.VarChar(100)
  hospitalAffiliation String?   @db.VarChar(191)
  phone               String?   @db.VarChar(50)
  email               String?   @db.VarChar(191)
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?   @db.VarChar(191)
  updatedBy           String?   @db.VarChar(191)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]

  @@index([tenantId])
  @@index([licenseNumber])
  @@map("doctors")
}

// ============================================================================
// GROUP 6: PROCUREMENT (PURCHASING)
// ============================================================================

/// Purchase represents inbound procurement orders and vendor invoices.
model Purchase {
  id             String         @id @default(uuid())
  tenantId       String         @db.VarChar(191)
  supplierId     String         @db.VarChar(191)
  branchId       String?        @db.VarChar(191)
  warehouseId    String?        @db.VarChar(191)
  invoiceNumber  String         @db.VarChar(100)
  purchaseDate   DateTime       @default(now())
  status         PurchaseStatus @default(PENDING)
  totalAmount    Decimal        @db.Decimal(12, 2)
  paidAmount     Decimal        @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0.00) @db.Decimal(12, 2)
  notes          String?        @db.VarChar(255)
  isDeleted      Boolean        @default(false)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?        @db.VarChar(191)
  updatedBy      String?        @db.VarChar(191)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch       Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items        PurchaseItem[]
  paymentLinks SupplierPaymentLink[]

  @@unique([tenantId, supplierId, invoiceNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([status])
  @@index([purchaseDate])
  @@map("purchases")
}

/// PurchaseItem represents line items inside a procurement invoice.
model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String   @db.VarChar(191)
  medicineId String   @db.VarChar(191)
  batchId    String?  @db.VarChar(191)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  tax        Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine Medicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    MedicineBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([medicineId])
  @@index([batchId])
  @@map("purchase_items")
}

// ============================================================================
// GROUP 7: SALES & POS
// ============================================================================

/// Sale represents retail POS transactions and dispensed medication orders.
model Sale {
  id             String     @id @default(uuid())
  tenantId       String     @db.VarChar(191)
  branchId       String     @db.VarChar(191)
  customerId     String?    @db.VarChar(191)
  userId         String     @db.VarChar(191) // Cashier / Pharmacist user
  prescriptionId String?    @db.VarChar(191)
  shiftId        String?    @db.VarChar(191)
  receiptNumber  String     @db.VarChar(100)
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @default(0.00) @db.Decimal(12, 2)
  tax            Decimal    @default(0.00) @db.Decimal(12, 2)
  totalAmount          Decimal               @db.Decimal(12, 2)
  paidAmount           Decimal               @default(0.00) @db.Decimal(12, 2)
  status               SaleStatus            @default(COMPLETED)
  saleDate             DateTime              @default(now())
  notes                String?               @db.VarChar(255)
  isDeleted            Boolean               @default(false)
  deletedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  createdBy            String?               @db.VarChar(191)
  updatedBy            String?               @db.VarChar(191)

  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer               Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user                   PharmacyUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  prescription           Prescription?         @relation("SaleAttachedPrescription", fields: [prescriptionId], references: [id], onDelete: SetNull)
  dispensedPrescriptions Prescription[]        @relation("PrescriptionDispensedSale")
  shift                  Shift?                @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items                  SaleItem[]
  payments               Payment[]
  customerPaymentLinks   CustomerPaymentLink[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([branchId])
  @@index([customerId])
  @@index([userId])
  @@index([prescriptionId])
  @@index([shiftId])
  @@index([status])
  @@index([saleDate])
  @@map("sales")
}

/// SaleItem records individual lines within a dispensed pharmacy sale.
model SaleItem {
  id         String   @id @default(uuid())
  saleId     String   @db.VarChar(191)
  medicineId String   @db.VarChar(191)
  batchId    String   @db.VarChar(191)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0.00) @db.Decimal(12, 2)
  tax        Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sale     Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch    MedicineBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([medicineId])
  @@index([batchId])
  @@map("sale_items")
}

/// Payment records transaction settlement across various payment instruments.
model Payment {
  id              String        @id @default(uuid())
  tenantId        String        @db.VarChar(191)
  saleId          String?       @db.VarChar(191)
  type            PaymentType   @default(CUSTOMER_RECEIPT)
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(SUCCESS)
  referenceNumber String?       @db.VarChar(100)
  date            DateTime      @default(now())
  notes           String?       @db.Text
  recordedById    String?       @db.VarChar(191)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String?       @db.VarChar(191)
  updatedBy       String?       @db.VarChar(191)

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale            Sale?                 @relation(fields: [saleId], references: [id], onDelete: SetNull)
  recordedBy      PharmacyUser?         @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)
  supplierLinks   SupplierPaymentLink[]
  customerLinks   CustomerPaymentLink[]
  accountLedgers  AccountLedger[]

  @@index([tenantId])
  @@index([saleId])
  @@index([type])
  @@index([method])
  @@index([status])
  @@index([date])
  @@map("payments")
}

/// Prescription registers clinical medical orders issued by practitioners.
model Prescription {
  id                 String             @id @default(uuid())
  tenantId           String             @db.VarChar(191)
  patientId          String             @db.VarChar(191)
  doctorId           String?            @db.VarChar(191)
  verifiedById       String?            @db.VarChar(191)
  saleId             String?            @db.VarChar(191)
  prescriptionNumber String?            @db.VarChar(100)
  prescriptionDate   DateTime           @default(now())
  status             PrescriptionStatus @default(PENDING)
  notes              String?            @db.VarChar(255)
  verifiedAt         DateTime?
  isDeleted          Boolean            @default(false)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  createdBy          String?            @db.VarChar(191)
  updatedBy          String?            @db.VarChar(191)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor     Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  verifiedBy PharmacyUser?      @relation("VerifiedPrescriptions", fields: [verifiedById], references: [id], onDelete: SetNull)
  sale       Sale?              @relation("PrescriptionDispensedSale", fields: [saleId], references: [id], onDelete: SetNull)
  sales      Sale[]             @relation("SaleAttachedPrescription")
  items      PrescriptionItem[]

  @@unique([tenantId, prescriptionNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([doctorId])
  @@index([verifiedById])
  @@index([saleId])
  @@index([status])
  @@index([prescriptionDate])
  @@map("prescriptions")
}

/// PrescriptionItem records individual prescribed drug regimens, dosages, and schedules.
model PrescriptionItem {
  id               String   @id @default(uuid())
  prescriptionId   String   @db.VarChar(191)
  medicineId       String   @db.VarChar(191)
  dosage           String   @db.VarChar(100) // e.g. "500mg" or "1 tablet"
  frequency        String   @db.VarChar(100) // e.g. "1x3 daily" or "Twice daily after meals"
  duration         String   @db.VarChar(100) // e.g. "5 days"
  quantityRequired Int      @default(1)
  quantity         Int      @default(1)
  instructions     String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_items")
}

// ============================================================================
// GROUP 8: FINANCE & AUDIT
// ============================================================================

/// ExpenseCategory defines customizable operational cost categories.
model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String   @db.VarChar(191)
  name        String   @db.VarChar(191)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?  @db.VarChar(191)
  updatedBy   String?  @db.VarChar(191)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

/// Expense records operational branch expenditures, overhead, and clinical utilities.
model Expense {
  id             String        @id @default(uuid())
  tenantId       String        @db.VarChar(191)
  branchId       String?       @db.VarChar(191)
  categoryId     String        @db.VarChar(191)
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @default(now())
  description    String        @db.Text
  receiptUrl     String?       @db.Text
  paymentMethod  PaymentMethod @default(CASH)
  recordedById   String?       @db.VarChar(191)
  isReversed     Boolean       @default(false)
  reversedAt     DateTime?
  reversalReason String?       @db.Text
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?       @db.VarChar(191)
  updatedBy      String?       @db.VarChar(191)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy     PharmacyUser?   @relation("RecordedExpenses", fields: [recordedById], references: [id], onDelete: SetNull)
  accountLedgers AccountLedger[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([branchId])
  @@index([date])
  @@map("expenses")
}

/// SupplierPaymentLink maps a lump-sum Payment to specific Purchase invoices.
model SupplierPaymentLink {
  id            String   @id @default(uuid())
  tenantId      String   @db.VarChar(191)
  paymentId     String   @db.VarChar(191)
  purchaseId    String   @db.VarChar(191)
  amountApplied Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@index([purchaseId])
  @@map("supplier_payment_links")
}

/// CustomerPaymentLink maps a customer receipt Payment to specific credit Sale invoices.
model CustomerPaymentLink {
  id            String   @id @default(uuid())
  tenantId      String   @db.VarChar(191)
  paymentId     String   @db.VarChar(191)
  saleId        String   @db.VarChar(191)
  amountApplied Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@index([saleId])
  @@map("customer_payment_links")
}

/// AccountLedger tracks double-entry financial debits and credits across accounts.
model AccountLedger {
  id            String      @id @default(uuid())
  tenantId      String      @db.VarChar(191)
  accountType   AccountType
  entityType    String?     @db.VarChar(50) // "CUSTOMER", "SUPPLIER", "EXPENSE", "REVENUE"
  entityId      String?     @db.VarChar(191) // customerId or supplierId
  debit         Decimal     @default(0.00) @db.Decimal(12, 2)
  credit        Decimal     @default(0.00) @db.Decimal(12, 2)
  balanceAfter  Decimal     @db.Decimal(12, 2)
  referenceType String?     @db.VarChar(50) // "PURCHASE", "SALE", "EXPENSE", "PAYMENT", "REVERSAL"
  referenceId   String?     @db.VarChar(191)
  description   String      @db.Text
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
  createdBy     String?     @db.VarChar(191)

  paymentId     String?     @db.VarChar(191)
  expenseId     String?     @db.VarChar(191)
  customerId    String?     @db.VarChar(191)
  supplierId    String?     @db.VarChar(191)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment  Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expense  Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([accountType])
  @@index([entityId])
  @@index([referenceId])
  @@index([date])
  @@map("account_ledgers")
}

/// AuditLog maintains an immutable forensic trail of mutations across tenant entities.
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @db.VarChar(191)
  userId    String?  @db.VarChar(191)
  action    String   @db.VarChar(100) // e.g. "UPDATE_STOCK", "DELETE_SALE", "DISPENSE_PRESCRIPTION"
  entity    String   @db.VarChar(100) // e.g. "Medicine", "Sale", "InventoryLedger"
  entityId  String   @db.VarChar(191)
  oldValues Json?
  newValues Json?
  ipAddress String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   PharmacyUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// GROUP 9: CASHIER SHIFTS & FINANCIAL ACCOUNTABILITY
// ============================================================================

/// Shift represents a cash register shift session for a cashier/pharmacist at a specific branch.
model Shift {
  id           String      @id @default(uuid())
  tenantId     String      @db.VarChar(191)
  userId       String      @db.VarChar(191)
  branchId     String      @db.VarChar(191)
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @db.Decimal(12, 2)
  closingCash  Decimal?    @db.Decimal(12, 2)
  expectedCash Decimal?    @db.Decimal(12, 2)
  variance     Decimal?    @db.Decimal(12, 2)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  notes        String?     @db.VarChar(255)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdBy    String?     @db.VarChar(191)
  updatedBy    String?     @db.VarChar(191)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         PharmacyUser       @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales        Sale[]
  transactions ShiftTransaction[]

  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@index([openedAt])
  @@map("shifts")
}

/// ShiftTransaction logs manual cash additions, payouts, or drops during an active shift.
model ShiftTransaction {
  id        String               @id @default(uuid())
  tenantId  String               @db.VarChar(191)
  shiftId   String               @db.VarChar(191)
  type      ShiftTransactionType
  amount    Decimal              @db.Decimal(12, 2)
  reason    String?              @db.VarChar(255)
  createdAt DateTime             @default(now())
  createdBy String?              @db.VarChar(191)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shift  Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shiftId])
  @@index([type])
  @@map("shift_transactions")
}
